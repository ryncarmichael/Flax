;Flax File Copy Program
_start:
	lda #inFile
	in fileIO, openFile

	lda #outFile
	out fileIO, appendFile
	
copyLoop:
	lda inFile
	jl endCopy
	sta outFile
	jp copyLoop	
		
endCopy:
	lda #inFile
	in fileIO, closeFile
	
	lda #outFile
	out fileIO, closeFile

	brk

file inFile, "files/test.txt"
file outFile, "files/out.txt"