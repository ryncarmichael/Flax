;Flax Colors and Cursor Example
_start:
	lda true
	sys flag, debugEnabled
	sys flag, autoPauseEnabled
	
	lda 100 ;Set very slow performance
	sys value, sysPerformance
	
	lda 35	;Set longer pause time
	sys value, autoPauseTime
	
	out terminal, cursorHide
	
mainLoop:
	
	;Colours
	lda 23
	rnd
	add 23
	out terminal

	;Background
	lda 15
	rnd
	jsrz bgColor

	;Style
	lda 2
	rnd
	jsrz style

	;Column and row
	lda 23
	rnd
	add 1
	out terminal, cursorRow

	lda 79
	rnd
	add 1
	out terminal, cursorColumn

	;Character
	lda 94
	rnd
	add 32
	out

	;Reset
	out terminal, styleReset

	;Handle KeyCodes
	in
	sta keyCode
	
	cmp 32		;Space
	jsrz clear
	
	lda keyCode	;Upcase A
	cmp 65
	jsrz hlt
	

	lda keyCode	;Escape
	cmp 27
	jsrz exit

	jp mainLoop
	
	brk

hlt:
	jsr clear
	hlt
	rts

bgColor:
	lda 15
	rnd
	add 47
	out terminal
	rts

style:
	lda 3
	rnd
	add 15
	out terminal
	rts

clear:
	out terminal, clearScreen
	out terminal, clearHistory
	out terminal, cursorScreenHome
	rts
	
exit:
	out terminal, cursorShow
	jsr clear
	brk
	rts

db keyCode, 0




