;Flax Enhanced Bubblesort Example
_start:
	lda true
	sys flag, debugEnabled

	jsr fillBuffer
	jsr printData
	jsr bubbleSort
	jsr printData
	
	lda loops
	out number

exit:
	brk


bubbleSort:
	
sortStart:
	lda loops
	inc
	sta loops

	lda false
	sta flip

	lda 0
	sta lvp
	inc
	sta uvp

	lda count
	stc
sortLoop:
	lda sortData, lvp
	sta r0
	lda sortData, uvp
	sta r1
	cmp r0
	jgz skipFlip
	
	xch r0, r1
	
	lda r0
	sta sortData, lvp
	lda r1
	sta sortData, uvp
	
	;lda lvp ;Store the highest flip, and reduce the loop count to that.
	;dec
	;sta count
		
	stb flip
	
skipFlip:
	lda uvp
	sta lvp
	inc
	sta uvp
	lp sortLoop
	
	;lda oldcount
	;sub count
	;jz skip
	;cmp 1
	;jz skip

	;lda oldcount
	;out number
	;lda count
	;out number
skip:
	;lda count
	;sta oldcount
	
	;lda count
	;dec
	;sta count
	
	lda flip
	jnz sortStart
	jsr padSections
	rts


printData:
	len sortData
	stc
printLoop:
	lda sortData, c
	out number
	lp printLoop

	jsr padSections
	rts


fillBuffer:
	len sortData
	stc
fillLoop:
	lda 100
	rnd
	sta sortData, c
	lp fillLoop
	rts


padSections:
	out terminal, cursorDown	
	out terminal, cursorDown
	out terminal, cursorLineHome
	rts


;Variables
db loops, 0
db count, 98
db oldcount, 98
db flip, 0
db lvp, 0
db uvp, 0
db sortData, &100

